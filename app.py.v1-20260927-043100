        "-t", f"{audio_duration:.6f}",
        "-c:v", "libx264",
        "-preset", "veryfast",
        "-crf", "20",
        "-pix_fmt", "yuv420p",
        "-c:a", "aac",
        "-b:a", "192k",
        "-ar", "48000",
        "-movflags", "+faststart",
        str(output_path),
    ])



def seconds_from_ffmpeg_time(value: str) -> float:
    parts = value.strip().split(":")

    if len(parts) != 3:
        return 0.0

    try:
        hours = float(parts[0])
        minutes = float(parts[1])
        seconds = float(parts[2])
    except ValueError:
        return 0.0

    return (hours * 3600) + (minutes * 60) + seconds


def ffmpeg_log_tail(log_path: Path, limit: int = 6000) -> str:
    if not log_path.exists():
        return ""

    try:
        text = log_path.read_text(
            encoding="utf-8",
            errors="replace"
        )
    except Exception:
        return ""

    return text[-limit:]


def run_ffmpeg_progress(
    command: list[str],
    job_dir: Path,
    state: dict,
    audio_duration: float,
    progress_start: float = 20.0,
    progress_end: float = 98.0,
    stage_name: str = "Đang render",
) -> int:
    if audio_duration <= 0:
        raise RuntimeError("Audio duration không hợp lệ")

    log_path = job_dir / "ffmpeg.log"

    started = time.time()
    last_state_write = 0.0

    with log_path.open(
        "a",
        encoding="utf-8",
        errors="replace",
    ) as log_file:

        process = subprocess.Popen(
            command,
            stdout=subprocess.PIPE,
            stderr=log_file,
            text=True,
            bufsize=1,
        )

        if process.stdout is None:
            process.kill()
            raise RuntimeError(
                "Không đọc được progress của FFmpeg"
            )

        rendered_seconds = 0.0

        for raw_line in process.stdout:
            line = raw_line.strip()

            if not line:
                continue

            if "=" not in line:
                continue

            key, value = line.split("=", 1)

            if key == "out_time":
                rendered_seconds = seconds_from_ffmpeg_time(value)

            elif key == "out_time_us":
                try:
                    rendered_seconds = max(
                        rendered_seconds,
                        float(value) / 1_000_000
                    )
                except ValueError:
                    pass

            if rendered_seconds < 0:
                rendered_seconds = 0

            ratio = min(
                1.0,
                rendered_seconds / audio_duration
            )

            progress = (
                progress_start
                + ((progress_end - progress_start) * ratio)
            )

            elapsed = max(
                0.0,
                time.time() - started
            )

            eta = None

            if ratio > 0.001:
                eta = max(
                    0.0,
                    (elapsed / ratio) - elapsed
                )

            now = time.time()

            if now - last_state_write < 0.5:
                continue

            last_state_write = now

            state.update({
                "status": "processing",
                "progress": round(progress, 1),
                "rendered_seconds": rendered_seconds,
                "rendered_time_text": format_duration(
                    rendered_seconds
                ),
                "eta_seconds": (
                    round(eta, 1)
                    if eta is not None
                    else None
                ),
                "eta_text": (
                    format_duration(eta)
                    if eta is not None
                    else None
                ),
                "message": (
                    f"{stage_name} "
                    f"{progress:.1f}%"
                ),
            })

            write_state(job_dir, state)

        return_code = process.wait()

    return return_code


def build_stream_copy_command(
    video_path: Path,
    audio_path: Path,
    output_path: Path,
    audio_duration: float,
) -> list[str]:

    return [
        "ffmpeg",
        "-y",

        "-stream_loop",
        "-1",

        "-i",
        str(video_path),

        "-i",
        str(audio_path),

        "-map",
        "0:v:0",

        "-map",
        "1:a:0",

        "-t",
        f"{audio_duration:.6f}",

        "-c:v",
        "copy",

        "-c:a",
        "aac",

        "-b:a",
        "192k",

        "-ar",
        "48000",

        "-movflags",
        "+faststart",

        "-avoid_negative_ts",
        "make_zero",

        "-progress",
        "pipe:1",

        "-nostats",

        str(output_path),
    ]


def build_h264_command(
    video_path: Path,
    audio_path: Path,
    output_path: Path,
    audio_duration: float,
) -> list[str]:

    return [
        "ffmpeg",
        "-y",

