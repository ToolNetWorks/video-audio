    video: UploadFile = File(...),
    audio: UploadFile = File(...),
):
    video_ext = safe_extension(video.filename, VIDEO_EXTENSIONS)
    audio_ext = safe_extension(audio.filename, AUDIO_EXTENSIONS)

    job_id = uuid.uuid4().hex
    job_dir = DATA_DIR / job_id
    job_dir.mkdir(parents=True, exist_ok=False)

    video_path = job_dir / f"input_video{video_ext}"
    audio_path = job_dir / f"input_audio{audio_ext}"

    try:
        save_upload(video, video_path)
        save_upload(audio, audio_path)
    except Exception:
        shutil.rmtree(job_dir, ignore_errors=True)
        raise HTTPException(500, "Không lưu được file upload")

    if video_path.stat().st_size <= 0:
        shutil.rmtree(job_dir, ignore_errors=True)
        raise HTTPException(400, "Video rỗng")

    if audio_path.stat().st_size <= 0:
        shutil.rmtree(job_dir, ignore_errors=True)
        raise HTTPException(400, "Audio rỗng")

    state = {
        "job_id": job_id,
        "status": "queued",
        "progress": 5,
        "message": "Đã nhận file. Đang chuẩn bị...",
        "video_path": str(video_path),
        "audio_path": str(audio_path),
        "video_filename": video.filename,
        "audio_filename": audio.filename,
    }

    write_state(job_dir, state)

    threading.Thread(
        target=process_job,
        args=(job_id,),
        daemon=True,
    ).start()

    return {
        "job_id": job_id,
        "status": "queued",
    }


@app.get("/api/jobs/{job_id}")
def job_status(job_id: str):
    job_dir = DATA_DIR / job_id

    if not job_dir.exists():
        raise HTTPException(
            404,
            "Job không tồn tại"
        )

    try:
        state = read_state(job_dir)
    except Exception:
        raise HTTPException(
            500,
            "Không đọc được trạng thái job"
        )

    status = state.get("status")

    elapsed_seconds = state.get(
        "elapsed_seconds",
        0
    )

    started_at = state.get(
        "render_started_at"
    )

    if (
        status == "processing"
        and started_at
    ):
        elapsed_seconds = max(
            0.0,
            time.time() - float(started_at)
        )

    public_state = {
        "job_id": state.get("job_id"),
        "status": status,
        "progress": state.get(
            "progress",
            0
        ),
        "message": state.get(
            "message"
        ),
        "error": state.get(
            "error"
        ),

        "video_duration": state.get(
            "video_duration"
        ),
        "video_duration_text": state.get(
            "video_duration_text"
        ),

        "audio_duration": state.get(
            "audio_duration"
        ),
        "audio_duration_text": state.get(
            "audio_duration_text"
        ),

        "rendered_seconds": state.get(
            "rendered_seconds",
            0
        ),
        "rendered_time_text": state.get(
            "rendered_time_text",
            "00:00:00"
        ),

        "elapsed_seconds": elapsed_seconds,
        "elapsed_text": format_duration(
            elapsed_seconds
        ),

        "eta_seconds": state.get(
            "eta_seconds"
        ),
        "eta_text": state.get(
            "eta_text"
        ),

        "output_duration": state.get(
            "output_duration"
        ),
        "output_duration_text": state.get(
            "output_duration_text"
        ),

        "estimated_loops": state.get(
            "estimated_loops"
        ),

        "video_codec": state.get(
            "video_codec"
        ),

        "output_size": state.get(
            "output_size"
        ),
    }

    return public_state


@app.get("/api/jobs/{job_id}/download")
def download(job_id: str):
    job_dir = DATA_DIR / job_id

    if not job_dir.exists():
        raise HTTPException(404, "Job không tồn tại")

    state = read_state(job_dir)

    if state.get("status") != "done":
        raise HTTPException(409, "Video chưa render xong")

    output_path = job_dir / "output.mp4"

    if not output_path.exists():
        raise HTTPException(404, "Không tìm thấy output")

    return FileResponse(
        output_path,
        media_type="video/mp4",
        filename=f"looped-{job_id[:8]}.mp4",
    )
