def process_job(job_id: str) -> None:
    job_dir = DATA_DIR / job_id

    try:
        state = read_state(job_dir)

        video_path = Path(state["video_path"])
        audio_path = Path(state["audio_path"])
        output_path = job_dir / "output.mp4"

        render_started_at = time.time()

        state.update({
            "status": "processing",
            "progress": 8,
            "message": "Đang đọc thông tin video và audio...",
            "render_started_at": render_started_at,
            "eta_seconds": None,
            "eta_text": None,
            "rendered_seconds": 0,
            "rendered_time_text": "00:00:00",
        })

        write_state(job_dir, state)

        video_duration = probe_duration(video_path)
        audio_duration = probe_duration(audio_path)

        if video_duration <= 0:
            raise RuntimeError(
                "Video không có thời lượng hợp lệ"
            )

        if audio_duration <= 0:
            raise RuntimeError(
                "Audio không có thời lượng hợp lệ"
            )

        codec = probe_video_codec(video_path)

        estimated_loops = max(
            1,
            int(audio_duration / video_duration) + 1
        )

        state.update({
            "video_duration": video_duration,
            "video_duration_text": format_duration(
                video_duration
            ),
            "audio_duration": audio_duration,
            "audio_duration_text": format_duration(
                audio_duration
            ),
            "video_codec": codec,
            "estimated_loops": estimated_loops,
            "progress": 20,
            "message": (
                f"Đang render • "
                f"{estimated_loops} vòng loop"
            ),
        })

        write_state(job_dir, state)

        command = build_stream_copy_command(
            video_path,
            audio_path,
            output_path,
            audio_duration,
        )

        return_code = run_ffmpeg_progress(
            command=command,
            job_dir=job_dir,
            state=state,
            audio_duration=audio_duration,
            progress_start=20,
            progress_end=98,
            stage_name="Đang render",
        )

        if return_code != 0:
            if output_path.exists():
                output_path.unlink()

            state.update({
                "progress": 20,
                "rendered_seconds": 0,
                "rendered_time_text": "00:00:00",
                "eta_seconds": None,
                "eta_text": None,
                "message": (
                    "Codec nguồn không tương thích. "
                    "Đang encode H.264..."
                ),
            })

            write_state(job_dir, state)

            command = build_h264_command(
                video_path,
                audio_path,
                output_path,
                audio_duration,
            )

            return_code = run_ffmpeg_progress(
                command=command,
                job_dir=job_dir,
                state=state,
                audio_duration=audio_duration,
                progress_start=20,
                progress_end=98,
                stage_name="Đang encode H.264",
            )

        if return_code != 0:
            error = ffmpeg_log_tail(
                job_dir / "ffmpeg.log"
            )

            raise RuntimeError(
                error or "FFmpeg render failed"
            )

        if not output_path.exists():
            raise RuntimeError(
                "FFmpeg không tạo output"
            )

        if output_path.stat().st_size <= 0:
            raise RuntimeError(
                "Output rỗng"
            )

        output_duration = probe_duration(
            output_path
        )

        elapsed = max(
            0.0,
            time.time() - render_started_at
        )

        state.update({
            "status": "done",
            "progress": 100,
            "message": "Hoàn tất.",
            "output_path": str(output_path),
            "output_duration": output_duration,
            "output_duration_text": format_duration(
                output_duration
            ),
            "output_size": output_path.stat().st_size,
            "rendered_seconds": audio_duration,
            "rendered_time_text": format_duration(
                audio_duration
            ),
            "elapsed_seconds": elapsed,
            "elapsed_text": format_duration(
                elapsed
            ),
            "eta_seconds": 0,
            "eta_text": "00:00:00",
        })

        write_state(job_dir, state)

    except Exception as exc:
        try:
            state = read_state(job_dir)
        except Exception:
            state = {}

        started_at = state.get(
            "render_started_at"
        )

        elapsed = 0.0

        if started_at:
            elapsed = max(
                0.0,
                time.time() - float(started_at)
            )

        state.update({
            "status": "failed",
            "progress": 0,
            "message": "Render thất bại.",
            "error": str(exc),
            "elapsed_seconds": elapsed,
            "elapsed_text": format_duration(
                elapsed
            ),
        })

        write_state(job_dir, state)



def safe_extension(filename: str | None, allowed: set[str]) -> str:
    if not filename:
        raise HTTPException(400, "Tên file không hợp lệ")

    suffix = Path(filename).suffix.lower()

    if suffix not in allowed:
        raise HTTPException(
            400,
            f"Định dạng không hỗ trợ: {suffix or 'unknown'}"
        )

    return suffix


def save_upload(upload: UploadFile, destination: Path) -> None:
    with destination.open("wb") as output:
        shutil.copyfileobj(upload.file, output, length=1024 * 1024)


