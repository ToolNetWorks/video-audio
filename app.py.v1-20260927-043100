        "-1",

        "-i",
        str(video_path),

        "-i",
        str(audio_path),

        "-map",
        "0:v:0",

        "-map",
        "1:a:0",

        "-t",
        f"{audio_duration:.6f}",

        "-c:v",
        "libx264",

        "-preset",
        "veryfast",

        "-crf",
        "20",

